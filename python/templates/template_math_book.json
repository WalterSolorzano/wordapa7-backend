{
  "template_name": "Guía Ingeniería Económica — Estilo Libro de Matemáticas",
  "template_id": "guide_ie_v1",
  "version": "1.0",
  
  "page": {
    "size": "A4",
    "margins": {
      "top": "2.3cm",
      "bottom": "2.3cm",
      "left": "2.3cm",
      "right": "2.3cm"
    },
    "header_height": "14pt"
  },
  
  "colors": {
    "primary": "#1B3A5F",
    "secondary": "#E67E22",
    "accent": "#1E7E34",
    "secondary_dark": "#2E5C8A",
    "primary_light": "#E8F0F7",
    "secondary_light": "#FDF2E9",
    "secondary_dark_text": "#B9540A",
    "accent_light": "#D4EDDA",
    "neutral_bg": "#F7F7F7",
    "text_gray": "#444444"
  },
  
  "typography": {
    "body_font": "Latin Modern Roman",
    "headings_font": "Latin Modern Sans",
    "math_font": "Latin Modern Math",
    "body_size": "11pt",
    "line_height": "1.15"
  },
  
  "headings": {
    "h1": {
      "color": "#1B3A5F",
      "size": "17pt",
      "bold": true,
      "font_family": "sans-serif",
      "rule_below": true,
      "rule_color": "#1B3A5F",
      "rule_thickness": "1pt",
      "space_before": "1.5ex",
      "space_after": "1.0ex"
    },
    "h2": {
      "color": "#2E5C8A",
      "size": "14pt",
      "bold": true,
      "font_family": "sans-serif",
      "space_before": "1.0ex",
      "space_after": "0.8ex"
    },
    "h3": {
      "color": "#2E5C8A",
      "size": "12pt",
      "bold": true,
      "font_family": "sans-serif",
      "space_before": "0.8ex",
      "space_after": "0.6ex"
    }
  },
  
  "components": {
    "trampa_box": {
      "trigger_keywords": ["trampa:", "advertencia:", "cuidado:", "atención:"],
      "bg_color": "#FDF2E9",
      "border_color": "#E67E22",
      "border_width": "1pt",
      "border_radius": "3pt",
      "padding": "8pt 8pt 10pt 8pt",
      "title": "¡Trampa del profesor!",
      "title_bg": "#E67E22",
      "title_color": "#FFFFFF",
      "title_font": "bold sans-serif",
      "body_prefix": "¿En qué te puede pillar?",
      "body_prefix_color": "#B9540A",
      "body_size": "10pt",
      "breakable": true
    },
    "formula_box": {
      "trigger_keywords": ["fórmula:", "formula clave:", "definición:"],
      "bg_color": "#E8F0F7",
      "border_color": "#1B3A5F",
      "border_width": "1pt",
      "border_radius": "3pt",
      "padding": "8pt 8pt 10pt 8pt",
      "title_is_parameter": true,
      "title_bg": "#1B3A5F",
      "title_color": "#FFFFFF",
      "body_size": "11pt",
      "formula_alignment": "center",
      "breakable": true
    },
    "nota_box": {
      "trigger_keywords": ["nota:", "recuerda:", "recordatorio:"],
      "bg_color": "#D4EDDA",
      "border_color": "#1E7E34",
      "border_width": "0.8pt",
      "border_radius": "3pt",
      "padding": "8pt 8pt 10pt 8pt",
      "title": "Nota",
      "title_bg": "#1E7E34",
      "title_color": "#FFFFFF",
      "body_size": "10pt",
      "breakable": true
    },
    "ejemplo_box": {
      "trigger_keywords": ["ejemplo:", "ejemplo resuelto:", "ej:"],
      "bg_color": "#FFFFFF",
      "border_color": "#2E5C8A",
      "border_width": "0.6pt",
      "border_radius": "2pt",
      "padding": "8pt 8pt 6pt 6pt",
      "title": "Ejemplo resuelto",
      "title_bg": "#2E5C8A",
      "title_color": "#FFFFFF",
      "title_offset_left": "8pt",
      "body_size": "10pt",
      "breakable": true
    },
    "ejercicio_box": {
      "trigger_keywords": ["ejercicio", "ej."],
      "bg_color": "#F7F7F7",
      "border_color": "#1B3A5F",
      "border_opacity": 0.4,
      "border_width": "0.5pt",
      "border_radius": "2pt",
      "padding": "7pt 7pt 4pt 4pt",
      "no_title": true,
      "body_size": "10pt",
      "space_before": "4pt",
      "space_after": "4pt",
      "breakable": true
    },
    "hoja_box": {
      "trigger_keywords": ["hoja de", "práctica"],
      "bg_color": "#E8F0F7",
      "bg_opacity": 0.5,
      "border_color": "#1B3A5F",
      "border_width": "0.8pt",
      "border_radius": "3pt",
      "padding": "6pt",
      "title": "Hoja de práctica",
      "title_bg": "#1B3A5F",
      "title_color": "#FFFFFF",
      "is_container": true,
      "breakable": true
    }
  },
  
  "tables": {
    "default_style": "booktabs",
    "header_bg": "#1B3A5F",
    "header_text_color": "#FFFFFF",
    "header_font": "bold sans-serif 10pt",
    "body_font": "serif 10pt",
    "no_vertical_lines": true,
    "alternating_row_bg": "#F7F7F7",
    "alt_row_every": 2,
    "padding": "6pt 4pt",
    "float_right_small_table": {
      "enabled": true,
      "max_columns": 3,
      "max_rows": 8,
      "width": "35% of content width",
      "font_size": "9pt",
      "text_wraps_around": true,
      "gap_to_text": "0.8cm"
    },
    "long_table": {
      "enabled_for_rows_above": 15,
      "repeat_header_on_page_break": true
    }
  },
  
  "formulas": {
    "inline_delimiters": ["$...$"],
    "display_delimiters": ["$$...$$", "\\[...\\]"],
    "numbered_pattern": "(chapter.number)",
    "number_alignment": "right",
    "number_font": "serif 11pt",
    "formula_font": "Latin Modern Math",
    "display_size": "12pt",
    "display_centered": true,
    "display_space_before": "1em",
    "display_space_after": "1em"
  },
  
  "lists": {
    "bullets": {"item_gap": "2pt", "top_gap": "2pt"},
    "numbered": {"item_gap": "2pt", "top_gap": "2pt"},
    "nested_levels": 3,
    "indent_per_level": "1.2em"
  },
  
  "spacing": {
    "paragraph_after": "0.5em",
    "between_box_and_text": "0.8ex",
    "between_boxes": "4pt",
    "between_table_and_text": "1em",
    "between_formula_and_text": "1em"
  },
  
  "anti_cut_rules": {
    "widow_orphan_penalty": 10000,
    "boxes_breakable": true,
    "needspace_before_h1": "4 lines",
    "needspace_before_h2": "3 lines",
    "needspace_before_h3": "2 lines",
    "long_table_repeats_header": true,
    "keep_together_groups": ["heading+figure+caption", "table+caption"]
  },
  
  "cover": {
    "background": "#1B3A5F",
    "top_band": {"color": "#E67E22", "height": "1.2cm"},
    "bottom_band": {"color": "#E67E22", "height": "1.2cm"},
    "decorative_line": {
      "color": "#FFFFFF",
      "thickness": "1.5pt",
      "y_offset_from_top": "3cm",
      "lateral_margin": "2cm"
    },
    "title_color": "#FFFFFF",
    "subtitle_color": "#FFFFFF",
    "label_color": "#E67E22",
    "summary_box": {
      "bg": "#FFFFFF",
      "border_color": "#E67E22",
      "border_width": "1pt",
      "border_radius": "4pt",
      "width": "12cm"
    }
  },
  
  "header_footer": {
    "header_left_text": "Ingeniería Económica — 1ª Evaluación",
    "header_left_color": "#1B3A5F",
    "header_left_font": "sans-serif 9pt",
    "header_right_text": "{page_number}",
    "header_right_color": "#1B3A5F",
    "header_right_font": "sans-serif 9pt",
    "header_rule_color": "#1B3A5F",
    "header_rule_thickness": "0.4pt",
    "footer": null
  },
  
  "toc": {
    "title": "Índice",
    "title_color": "#1B3A5F",
    "title_font": "sans-serif 17pt bold",
    "title_rule_below": true,
    "level1_font": "serif 11pt bold",
    "level2_font": "serif 10pt regular",
    "level3_font": "serif 10pt italic",
    "leader_dots": true,
    "page_number_alignment": "right",
    "page_number_color": "#1B3A5F",
    "page_break_after": true
  }
}

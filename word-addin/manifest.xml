<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
  xsi:type="TaskPaneApp">

  <!-- ===================================================================== -->
  <!-- WordAPA7 — Word Add-in Manifest                                        -->
  <!-- ===================================================================== -->

  <Id>56d02414-d45c-456c-a180-9123fbfa206d</Id>
  <Version>1.1.0.0</Version>
  <ProviderName>WordAPA7</ProviderName>
  <DefaultLocale>es-ES</DefaultLocale>
  <DisplayName DefaultValue="WordAPA7 — Asistente APA 7" />
  <Description DefaultValue="Asistente APA 7 en vivo dentro de Word: detecta citas, aplica formato APA 7 al vuelo y numera figuras y tablas automaticamente cuando las pegás." />
  <IconUrl DefaultValue="https://localhost:8742/addin/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://localhost:8742/addin/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/WalterSolorzano/ProyectoAPA7" />
  <AppDomains>
    <AppDomain>https://localhost:8742</AppDomain>
    <AppDomain>https://127.0.0.1:8742</AppDomain>
  </AppDomains>

  <Hosts>
    <Host Name="Document" />
  </Hosts>

  <Requirements>
    <Sets DefaultMinVersion="1.1">
      <Set Name="WordApi" MinVersion="1.3" />
    </Sets>
  </Requirements>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://localhost:8742/addin/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!-- ===================================================================== -->
  <!-- Version Overrides — Ribbon con 4 grupos y 11 botones                  -->
  <!-- ===================================================================== -->
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">

    <Hosts>
      <Host xsi:type="Document">
        <DesktopFormFactor>
          <FunctionFile resid="WordAPA7.Commands.Url" />

          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <!-- Acceso rápido en la pestaña Inicio (Home) de Microsoft Word -->
            <OfficeTab id="TabHome">
              <Group id="WordAPA7.HomeGroup">
                <Label resid="WordAPA7.TabLabel" />
                <Icon>
                  <bt:Image size="16" resid="WordAPA7.Icon.Panel.16" />
                  <bt:Image size="32" resid="WordAPA7.Icon.Panel.32" />
                  <bt:Image size="80" resid="WordAPA7.Icon.Panel.80" />
                </Icon>
                <Control xsi:type="Button" id="WordAPA7.HomeOpenTaskpane">
                  <Label resid="WordAPA7.OpenPanel.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.OpenPanel.Label" />
                    <Description resid="WordAPA7.OpenPanel.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Panel.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Panel.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Panel.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WordAPA7.Taskpane</TaskpaneId>
                    <SourceLocation resid="WordAPA7.Taskpane.Url" />
                  </Action>
                </Control>
                <Control xsi:type="Button" id="WordAPA7.HomePassAPAQuick">
                  <Label resid="WordAPA7.PassAPALabel" />
                  <Supertip>
                    <Title resid="WordAPA7.PassAPALabel" />
                    <Description resid="WordAPA7.PassAPADesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>passAPAQuick</FunctionName>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>

            <!-- Pestaña dedicada WordAPA7 -->
            <CustomTab id="WordAPA7.Tab">

              <!-- ================================================================ -->
              <!-- Grupo 1: Asistente                                                -->
              <!-- ================================================================ -->
              <Group id="WordAPA7.GroupAssistant">
                <Label resid="WordAPA7.GroupAssistantLabel" />
                <Icon>
                  <bt:Image size="16" resid="WordAPA7.Icon.Panel.16" />
                  <bt:Image size="32" resid="WordAPA7.Icon.Panel.32" />
                  <bt:Image size="80" resid="WordAPA7.Icon.Panel.80" />
                </Icon>

                <!-- Abrir panel -->
                <Control xsi:type="Button" id="WordAPA7.OpenTaskpane">
                  <Label resid="WordAPA7.OpenPanel.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.OpenPanel.Label" />
                    <Description resid="WordAPA7.OpenPanel.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Panel.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Panel.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Panel.80" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>WordAPA7.Taskpane</TaskpaneId>
                    <SourceLocation resid="WordAPA7.Taskpane.Url" />
                  </Action>
                </Control>

                <!-- Pasar a APA -->
                <Control xsi:type="Button" id="WordAPA7.PassAPAQuick">
                  <Label resid="WordAPA7.PassAPALabel" />
                  <Supertip>
                    <Title resid="WordAPA7.PassAPALabel" />
                    <Description resid="WordAPA7.PassAPADesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>passAPAQuick</FunctionName>
                  </Action>
                </Control>

                <!-- Auditar APA 7 -->
                <Control xsi:type="Button" id="WordAPA7.Audit">
                  <Label resid="WordAPA7.Audit.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Audit.Label" />
                    <Description resid="WordAPA7.Audit.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Audit.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Audit.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Audit.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>validateSelection</FunctionName>
                  </Action>
                </Control>

                <!-- Actualizar -->
                <Control xsi:type="Button" id="WordAPA7.Refresh">
                  <Label resid="WordAPA7.Refresh.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Refresh.Label" />
                    <Description resid="WordAPA7.Refresh.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Refresh.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Refresh.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Refresh.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>refreshDocument</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- ================================================================ -->
              <!-- Grupo 2: Insertar APA 7                                          -->
              <!-- ================================================================ -->
              <Group id="WordAPA7.GroupInsert">
                <Label resid="WordAPA7.GroupInsertLabel" />
                <Icon>
                  <bt:Image size="16" resid="WordAPA7.Icon.Table.16" />
                  <bt:Image size="32" resid="WordAPA7.Icon.Table.32" />
                  <bt:Image size="80" resid="WordAPA7.Icon.Table.80" />
                </Icon>

                <!-- Tabla -->
                

                <!-- Figura -->
                

                <!-- Titulo -->
                
              </Group>

              <!-- ================================================================ -->
              <!-- Grupo 3: Referencias                                             -->
              <!-- ================================================================ -->
              <Group id="WordAPA7.GroupReferences">
                <Label resid="WordAPA7.GroupReferencesLabel" />
                <Icon>
                  <bt:Image size="16" resid="WordAPA7.Icon.Citation.16" />
                  <bt:Image size="32" resid="WordAPA7.Icon.Citation.32" />
                  <bt:Image size="80" resid="WordAPA7.Icon.Citation.80" />
                </Icon>

                <!-- Citas -->
                <Control xsi:type="Button" id="WordAPA7.Citation">
                  <Label resid="WordAPA7.Citation.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Citation.Label" />
                    <Description resid="WordAPA7.Citation.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Citation.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Citation.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Citation.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openReferences</FunctionName>
                  </Action>
                </Control>

                <!-- Bibliografia -->
                <Control xsi:type="Button" id="WordAPA7.Bibliography">
                  <Label resid="WordAPA7.Bibliography.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Bibliography.Label" />
                    <Description resid="WordAPA7.Bibliography.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Bibliography.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Bibliography.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Bibliography.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openBibliography</FunctionName>
                  </Action>
                </Control>

                <!-- Portada -->
                <Control xsi:type="Button" id="WordAPA7.Cover">
                  <Label resid="WordAPA7.Cover.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.Cover.Label" />
                    <Description resid="WordAPA7.Cover.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.Cover.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.Cover.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.Cover.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openCoverPage</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- ================================================================ -->
              <!-- Grupo 4: Herramientas                                            -->
              <!-- ================================================================ -->
              <Group id="WordAPA7.GroupTools">
                <Label resid="WordAPA7.GroupToolsLabel" />
                <Icon>
                  <bt:Image size="16" resid="WordAPA7.Icon.AI.16" />
                  <bt:Image size="32" resid="WordAPA7.Icon.AI.32" />
                  <bt:Image size="80" resid="WordAPA7.Icon.AI.80" />
                </Icon>

                <!-- IA -->
                <Control xsi:type="Button" id="WordAPA7.AI">
                  <Label resid="WordAPA7.AI.Label" />
                  <Supertip>
                    <Title resid="WordAPA7.AI.Label" />
                    <Description resid="WordAPA7.AI.Supertip" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="WordAPA7.Icon.AI.16" />
                    <bt:Image size="32" resid="WordAPA7.Icon.AI.32" />
                    <bt:Image size="80" resid="WordAPA7.Icon.AI.80" />
                  </Icon>
                  <Action xsi:type="ExecuteFunction">
                    <FunctionName>openAI</FunctionName>
                  </Action>
                </Control>
              </Group>

              <!-- Nombre de la pestaña (debe ir al final del CustomTab) -->
              <Label resid="WordAPA7.TabLabel" />

            </CustomTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>


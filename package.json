{
  "name": "wordapa7",
  "productName": "WordAPA7",
  "description": "Herramienta inteligente para dar formato APA 7",
  "author": "Antigravity",
  "version": "1.0.73",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WalterSolorzano/ProyectoAPA7.git"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && python python/build_manifest.py && npm run build:addin",
    "build:web": "vite build",
    "build:addin": "cd word-addin && npm install && npm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "electron:dev": "vite",
    "electron:build": "npm run build:backend && npm run build && electron-builder --publish always",
    "gen:api-types": "python python/scripts/export_api_types.py",
    "build:backend": "npm run gen:api-types && python python/embed_payload.py && python python/build_embedded.py"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@fontsource/outfit": "^5.3.0",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle": "^1.1.18",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@react-pdf/renderer": "^4.5.1",
    "electron-updater": "^6.8.9",
    "idb-keyval": "^6.3.0",
    "mammoth": "^1.7.2",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "use-debounce": "^10.1.1",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.26",
    "jsdom": "^29.1.1",
    "lucide-react": "^1.26.0",
    "postcss": "^8.4.47",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.4.5",
    "vite": "^5.3.1",
    "vite-plugin-electron": "^1.1.0",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.4"
  }
}
